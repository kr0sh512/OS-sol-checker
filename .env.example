# Copy to .env for local development. Never commit credentials.
# Compose reads role-scoped secret files from gitignored deploy/secrets/.
TASKS_REPOSITORY_URL=https://github.com/kr0sh512/OS-tasks
TASKS_REPOSITORY_REF=main
CATALOG_POLL_SECONDS=60
CATALOG_ROOT=var/catalog
TRANSIENT_DATABASE_URL=
ARCHIVE_DATABASE_URL=
PUBLIC_ORIGIN=
CSRF_SECRET=
MAX_SOURCE_BYTES=102400
MAX_REQUEST_BYTES=131072
MAX_CONCURRENT_SANDBOXES=4
QUEUE_CAPACITY=1000
COMPILE_TIMEOUT_SECONDS=10
RUN_TIMEOUT_SECONDS=2
SUBMISSION_DEADLINE_SECONDS=60
SANDBOX_MEMORY_MIB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMP_MIB=32
MAX_OUTPUT_BYTES=65536
MAX_ARTIFACT_BYTES=1048576
TRANSIENT_TTL_HOURS=24
SESSION_TTL_DAYS=30
# Internal worker-to-runner endpoint; never publish the runner port on the host.
RUNNER_URL=http://runner:8081
RUNNER_TOKEN=
# Required immutable runner image reference: registry/image@sha256:...
RUNNER_IMAGE=
APPLICATION_IMAGE=
CHECKER_CGROUP_HOST=
