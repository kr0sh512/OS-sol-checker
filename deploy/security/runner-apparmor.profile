#include <tunables/global>
profile checker-runner flags=(attach_disconnected,mediate_deleted) {
  # The outer API/nsjail are trusted. Untrusted children additionally receive the
  # stricter in-jail syscall allowlist, dropped capabilities and a pivoted root.
  #include <abstractions/base>
  network inet stream,
  network inet6 stream,
  network unix stream,
  network unix dgram,
  network netlink raw,
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability chown,
  capability dac_override,
  capability fowner,
  capability kill,
  capability setpcap,
  signal (send, receive) peer=checker-runner,
  signal (receive) peer=unconfined,
  / r,
  /opt/checker/ r,
  /opt/checker/** rix,
  /usr/local/bin/** rix,
  /usr/local/lib/** rix,
  /usr/bin/mount rix,
  /usr/bin/umount rix,
  /usr/bin/gcc rix,
  /usr/bin/*-gcc-* rix,
  /usr/bin/as rix,
  /usr/bin/ld rix,
  /usr/bin/*-as rix,
  /usr/bin/*-ld* rix,
  /usr/lib/** rix,
  /lib/** rix,
  /lib64/** rix,
  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /etc/passwd r,
  /etc/group r,
  /etc/nsswitch.conf r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /usr/include/** r,
  /checker-init rix,
  /checker-probe rix,
  /work/ r,
  /work/runner/ rw,
  /work/runner/** rwlk,
  /work/main rix,
  /work/** rwlk,
  /tmp/ rw,
  /tmp/** rwlk,
  /run/user/ rw,
  /run/user/** rwlk,
  /run/secrets/ r,
  /run/secrets/runner_token r,
  /dev/null rw,
  /dev/urandom r,
  /dev/random r,
  /proc/ r,
  /proc/** r,
  /proc/[0-9]*/uid_map w,
  /proc/[0-9]*/gid_map w,
  /proc/[0-9]*/setgroups w,
  /run/checker-cgroup/ rw,
  /run/checker-cgroup/** rw,
  mount options in (rw, ro, remount, bind, rbind, nosuid, nodev, noexec, relatime) /opt/checker/rootfs/** -> /run/user/**,
  mount options in (rw, ro, remount, bind, rbind, nosuid, nodev, noexec, relatime) /work/runner/** -> /run/user/**,
  mount options in (rw, ro, remount, bind, rbind, nosuid, nodev, noexec, relatime) -> /work/**,
  mount fstype=tmpfs -> /work/runner/**,
  mount fstype=tmpfs -> /run/user/**,
  mount fstype=proc -> /run/user/**,
  mount options=(rw, rprivate) -> /,
  mount options in (rw, ro, remount, bind, rbind, nosuid, nodev, noexec, relatime) -> /,
  mount options in (rw, ro, remount, bind, rbind, nosuid, nodev, noexec, relatime) -> /proc/,
  umount /,
  umount /run/user/**,
  umount /work/runner/**,
  pivot_root oldroot=/run/user/** /run/user/**,
  # No ptrace rule; no raw network; no module, BPF or host filesystem authority.
}
